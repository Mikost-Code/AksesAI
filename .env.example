# =============================================================================
# AksesAI — contoh environment variables
# Salin ke `.env.local` dan isi nilainya. JANGAN commit file berisi nilai asli.
# =============================================================================

# --- Aplikasi ---
# URL kanonik situs (untuk SEO, sitemap, dan redirect OAuth).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (aman dipublikasikan: URL & anon key dilindungi RLS) ---
# Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (RAHASIA, server-only; JANGAN pakai prefix NEXT_PUBLIC_) ---
# Dipakai hanya oleh: laporan anonim (/api/reports), cron, tugas sistem.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rate limiting (Upstash Redis) — sangat disarankan di produksi ---
# Bila kosong, aplikasi memakai fallback rate limit Postgres (butuh
# SUPABASE_SERVICE_ROLE_KEY). Bila KEDUANYA tidak tersedia, production
# bersikap FAIL-CLOSED: permintaan yang di-rate-limit DITOLAK (bukan
# diloloskan), sehingga salah konfigurasi tidak diam-diam mematikan proteksi.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Anti-bot laporan anonim (Cloudflare Turnstile) ---
# Di PRODUKSI, TURNSTILE_SECRET_KEY WAJIB diisi: tanpa secret, endpoint
# /api/reports menolak semua laporan (fail-closed) agar laporan anonim —
# yang ditulis lewat service_role — tidak terbuka bagi bot.
# Di development/test, kosong = verifikasi dilewati agar curl/seed mudah.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cloudflare Web Analytics — opsional, ramah privasi (tanpa cookie) ---
# Token beacon dari Cloudflare Dashboard → Web Analytics. Bila kosong,
# skrip analytics tidak dimuat sama sekali.
NEXT_PUBLIC_CF_BEACON_TOKEN=

# --- Cron & hashing (RAHASIA) ---
# CRON_SECRET: string acak panjang (>= 32 karakter). Wajib di produksi.
CRON_SECRET=
# IP_HASH_SALT: salt acak untuk hash IP pelapor (tidak menyimpan IP mentah).
IP_HASH_SALT=

# =============================================================================
# Catatan
# - GitHub OAuth Client ID/Secret dikonfigurasi di Dashboard Supabase
#   (Authentication → Providers → GitHub), BUKAN di file ini.
# - API key AI provider (OpenCode/9Router) TIDAK dipakai aplikasi runtime.
#   Simpan di konfigurasi lokal tools masing-masing developer, bukan di repo.
# =============================================================================
